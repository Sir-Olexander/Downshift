# Copy to .env. Never commit the real file.

# Model provider. Downshift picks the first configured one in this order:
# tokenfactory (NEBIUS_API_KEY, or TOKEN_FACTORY_API_KEY), ollama (OLLAMA_API_KEY), ollama-local, openai.
# A key already exported in your shell can be referenced instead of copied: NEBIUS_API_KEY=${TOKEN_FACTORY_API_KEY}
# Force one with DOWNSHIFT_PROVIDER=tokenfactory|ollama|ollama-local|openai.
NEBIUS_API_KEY=
OLLAMA_API_KEY=
DOWNSHIFT_PROVIDER=

# Max concurrent model calls per process (Ollama Cloud rejects more than a few).
DOWNSHIFT_MAX_CONCURRENT_CALLS=3
# On a 429 (concurrency or usage limit), wait with backoff for up to this many seconds per call.
DOWNSHIFT_RATE_LIMIT_MAX_WAIT_S=900

# Search tool for the demo agent: Tavily when set, Wikipedia (keyless) otherwise.
TAVILY_API_KEY=

# API keys the SDK may use to send runs (comma separated). Default: ds_dev
DOWNSHIFT_API_KEYS=ds_dev
# Where the SDK sends runs
DOWNSHIFT_ENDPOINT=http://localhost:8000
DOWNSHIFT_API_KEY=ds_dev

# Hosted demo: cap live optimizations (per hour) and keep them small
DOWNSHIFT_DEMO_MODE=true
DOWNSHIFT_MAX_LIVE_PER_HOUR=2
# Agents screen: the UI may browse folders and write harness.yaml only inside this root.
# Turn off on a public deployment.
DOWNSHIFT_ALLOW_FS=true
DOWNSHIFT_AGENTS_ROOT=

# Optimizer defaults
DOWNSHIFT_OPT_ROUNDS=2
DOWNSHIFT_OPT_SAMPLE=10
DOWNSHIFT_OPT_CONCURRENCY=3
DOWNSHIFT_TEST_FRACTION=0.4

# "Open PR": the repo that holds the demo agent, and a token with contents + pull_requests write.
# Locally the API falls back to `gh auth token` when GITHUB_TOKEN is empty.
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
GITHUB_HARNESS_PATH=demo_agent/harness.yaml
# Public URL of the web UI, linked from PR descriptions
DOWNSHIFT_PUBLIC_WEB_URL=http://localhost:3000

# Web: where the Next.js server reaches the API
API_URL=http://localhost:8000
